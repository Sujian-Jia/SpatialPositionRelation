+std::array<ToolPose,7> DockingDynamics::ArmJointFrames(const State& s)const{
+ const Geometry g=GeometryAt(s.q);
+ std::array<ToolPose,7> result;
+ for(int i=0;i<7;++i)result[i]={g.parts[i+1].p,g.parts[i+1].R};
