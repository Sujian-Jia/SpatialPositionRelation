# ============================================================
#  根目录白名单:只放行下面两个工程目录与三个说明文件,其余(dist 等)一律忽略
# ============================================================
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SpatialPositionRelation/
!/Spatial_Qt/

# ============================================================
#  归档:体积 29 GB,不参与版本管理
# ============================================================
/归档/

# ============================================================
#  Unity 自动生成物(可重建,不应入库)
# ============================================================
/SpatialPositionRelation/[Ll]ibrary/
/SpatialPositionRelation/[Tt]emp/
/SpatialPositionRelation/[Oo]bj/
/SpatialPositionRelation/[Bb]uild/
/SpatialPositionRelation/[Bb]uilds/
/SpatialPositionRelation/[Ll]ogs/
/SpatialPositionRelation/[Mm]emoryCaptures/
/SpatialPositionRelation/[Rr]ecordings/
/SpatialPositionRelation/[Uu]ser[Ss]ettings/
/SpatialPositionRelation/.vs/
/SpatialPositionRelation/.idea/
/SpatialPositionRelation/*.csproj
/SpatialPositionRelation/*.sln
/SpatialPositionRelation/*.suo
/SpatialPositionRelation/*.user
/SpatialPositionRelation/*.userprefs
/SpatialPositionRelation/*.pidb
/SpatialPositionRelation/*.booproj
/SpatialPositionRelation/*.svd
/SpatialPositionRelation/*.pdb
/SpatialPositionRelation/*.mdb

# ============================================================
#  Qt 构建目录
# ============================================================
/Spatial_Qt/SpatialPositionRelation/build/

# ============================================================
#  打包产物(522 MB,含 >100 MB 单文件,GitHub 拒收)
# ============================================================
/dist/

# ============================================================
#  系统 / 编辑器杂项
# ============================================================
Thumbs.db
Desktop.ini
.DS_Store
*.log
*.tmp

# Native Unity plugin generated by SpatialPositionRelation/Native7Dof/build-native.ps1
/SpatialPositionRelation/Assets/Plugins/x86_64/SpatialNative7Dof.dll
